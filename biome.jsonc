{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "performance": {
        // Inline handlers are used throughout (incl. inside .map loops where useCallback is impossible); no React Compiler/memo boundaries here.
        "noJsxPropsBind": "off"
      }
    }
  },
  "files": {
    "includes": [
      "!public",
      "!components/ui",
      "!hooks/use-mobile.ts",
      "!lib/utils.ts",
      "!.source"
    ]
  }
}
